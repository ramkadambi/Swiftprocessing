STRUCT TRANSFER-REQ.
   STRING  TXN-ID        [20];
   STRING  SRC-BANK      [11];
   STRING  SRC-ACCOUNT   [16];
   STRING  DEST-BANK     [11];
   STRING  DEST-ACCOUNT  [16];
   INT     AMOUNT;
   STRING  CURRENCY      [3];
END;

STRUCT TRANSFER-RESP.
   STRING  TXN-ID        [20];
   STRING  STATUS        [10];
   STRING  REASON        [50];
END;