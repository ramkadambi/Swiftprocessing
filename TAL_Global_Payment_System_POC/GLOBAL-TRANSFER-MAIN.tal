PROC PROCESS-INCOMING-PAYMENT (REQ, RESP);
TRANSFER-REQ REQ;
TRANSFER-RESP RESP;
BOOL OK;
BEGIN
   CALL VALIDATE-ACCOUNT (REQ.SRC-BANK, REQ.SRC-ACCOUNT, OK);
   IF NOT OK THEN GOTO FAIL;

   CALL SANCTIONS-CHECK (REQ.SRC-BANK, OK);
   IF NOT OK THEN GOTO FAIL;

   CALL CHECK-FUNDS (REQ.SRC-ACCOUNT, REQ.AMOUNT, OK);
   IF NOT OK THEN GOTO FAIL;

   CALL POST-PAYMENT (REQ.TXN-ID, OK);
   IF NOT OK THEN GOTO FAIL;

   RESP.STATUS := "SUCCESS";
   RESP.REASON := "POSTED";
   RETURN;

FAIL:
   RESP.STATUS := "FAILED";
   RESP.REASON := "REJECTED";
END;